# ============================================================
# MCP Browser Server 配置模板
# 使用方法：复制本文件为 agent.env，填入你自己的配置
#   cp agent.env.example agent.env   (Linux/macOS)
#   copy agent.env.example agent.env (Windows)
# ============================================================

# ---- LLM 配置（用于 open_browser 工具的自然语言 URL 推断）----
# 任意 OpenAI 兼容 API 均可：DeepSeek / OpenAI / ChatAnywhere / 本地 Ollama 等
MODEL_NAME=deepseek-chat
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ---- MCP 传输模式 ----
# stdio            : 本地 MCP 客户端通过子进程调用（默认，向后兼容 agent.py）
# sse              : SSE 远程模式，任意 MCP 客户端通过 HTTP 连接（推荐供他人使用）
# streamable-http  : Streamable HTTP 远程模式（较新协议）
MCP_TRANSPORT=sse

# ---- SSE/HTTP 模式的监听地址（仅当 MCP_TRANSPORT != stdio 时生效）----
# 默认 127.0.0.1:8765
# 仅本机访问用 127.0.0.1；若要让局域网其他机器连接，改为 0.0.0.0（注意安全风险）
MCP_HOST=127.0.0.1
MCP_PORT=8765

# ---- 浏览器配置（通常无需修改）----
# Chrome 远程调试端口，agent 重启后通过此端口 attach 到已运行的 Chrome
# REMOTE_DEBUG_PORT=9222
